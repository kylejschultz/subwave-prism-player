@@ -35,6 +35,21 @@ interface ThemeContextValue {
 }
 
 const ThemeContext = createContext<ThemeContextValue | null>(null);
+const PRISM_THEME_IDS = (process.env.NEXT_PUBLIC_PRISM_THEME_IDS || 'cyan-gloom')
+  .split(',')
+  .map(id => id.trim())
+  .filter(Boolean);
+
+function prismThemes(registry: Theme[], stationId: string | null): { themes: Theme[]; active: string | null } {
+  if (PRISM_THEME_IDS.length === 0) return { themes: registry, active: stationId };
+  const allowed = new Set(PRISM_THEME_IDS);
+  const themes = registry.filter(theme => allowed.has(theme.id));
+  const fallback = themes[0]?.id ?? stationId;
+  return {
+    themes: themes.length > 0 ? themes : registry.filter(theme => theme.id === stationId),
+    active: themes.some(theme => theme.id === stationId) ? stationId : fallback,
+  };
+}
 
 /** Read theme state from any client component. Returns null on the server
  *  and before the provider is mounted. */
