diff --git a/web/components/player/StationSetup.tsx b/web/components/player/StationSetup.tsx
new file mode 100644
--- /dev/null
+++ b/web/components/player/StationSetup.tsx
@@ -0,0 +1,161 @@
+'use client';
+
+import { FormEvent, useMemo, useState } from 'react';
+import { Loader2, Radio, RadioTower } from 'lucide-react';
+import { useStationTuner } from './StationTuner';
+
+type Phase = 'idle' | 'checking' | 'ready' | 'error';
+
+function normalizeStationUrl(input: string): string | null {
+  try {
+    const url = new URL(input.trim().match(/^https?:\/\//i) ? input.trim() : `https://${input.trim()}`);
+    return url.origin;
+  } catch {
+    return null;
+  }
+}
+
+async function validateStation(origin: string): Promise<string | null> {
+  const controller = new AbortController();
+  const timeout = setTimeout(() => controller.abort(), 5000);
+  try {
+    const res = await fetch(`${origin}/api/state`, {
+      cache: 'no-store',
+      signal: controller.signal,
+    });
+    if (!res.ok) return 'That address answered, but not like a Subwave station.';
+    const data: unknown = await res.json();
+    if (data && typeof data === 'object') return null;
+    return 'That station response was not readable.';
+  } catch {
+    return 'Could not reach a Subwave station at that address.';
+  } finally {
+    clearTimeout(timeout);
+  }
+}
+
+export default function StationSetup() {
+  const tuner = useStationTuner();
+  const [url, setUrl] = useState('');
+  const [phase, setPhase] = useState<Phase>('idle');
+  const [message, setMessage] = useState('');
+  const savedStations = useMemo(
+    () => tuner?.stations.filter(station => !station.isLocal) ?? [],
+    [tuner?.stations],
+  );
+
+  const submit = async (event: FormEvent<HTMLFormElement>) => {
+    event.preventDefault();
+    if (!tuner || phase === 'checking') return;
+    setMessage('');
+    const origin = normalizeStationUrl(url);
+    if (!origin) {
+      setPhase('error');
+      setMessage('Enter a valid station URL.');
+      return;
+    }
+
+    setPhase('checking');
+    const error = await validateStation(origin);
+    if (error) {
+      setPhase('error');
+      setMessage(error);
+      return;
+    }
+
+    const station = tuner.addCustomStation(origin);
+    if (!station) {
+      setPhase('error');
+      setMessage('Could not save that station.');
+      return;
+    }
+    setPhase('ready');
+    setMessage(`Tuned to ${station.name}.`);
+  };
+
+  return (
+    <main className="fixed inset-0 overflow-y-auto bg-bg text-ink">
+      <div className="flex min-h-svh items-center justify-center px-5 py-10">
+        <section className="w-full max-w-[460px] border border-ink bg-bg p-5 shadow-[8px_8px_0_var(--ink)] sm:p-6">
+          <div className="mb-6 flex items-start justify-between gap-4">
+            <div>
+              <div className="v3-eyebrow mb-2 flex items-center gap-2">
+                <RadioTower size={15} strokeWidth={1.8} />
+                Prism for Subwave
+              </div>
+              <h1 className="font-display text-[32px] leading-none sm:text-[42px]">
+                Choose station
+              </h1>
+            </div>
+            <div className="grid size-12 shrink-0 place-items-center border border-ink bg-ink text-bg">
+              <Radio size={22} strokeWidth={1.8} />
+            </div>
+          </div>
+
+          <form onSubmit={submit} className="space-y-4">
+            <label className="block">
+              <span className="v3-caption mb-2 block text-muted">Station URL</span>
+              <input
+                value={url}
+                onChange={event => {
+                  setUrl(event.target.value);
+                  if (phase !== 'checking') {
+                    setPhase('idle');
+                    setMessage('');
+                  }
+                }}
+                placeholder="https://radio.example.com"
+                inputMode="url"
+                autoCapitalize="none"
+                autoCorrect="off"
+                className="v3-focus w-full border border-ink bg-bg px-3 py-3 font-mono text-[14px] text-ink outline-none placeholder:text-muted"
+              />
+            </label>
+
+            <button
+              type="submit"
+              disabled={phase === 'checking'}
+              className="v3-focus flex h-11 w-full items-center justify-center gap-2 border border-ink bg-ink px-4 text-[12px] font-bold tracking-[0.14em] text-bg uppercase disabled:cursor-wait disabled:opacity-70"
+            >
+              {phase === 'checking' && <Loader2 size={15} className="animate-spin" />}
+              {phase === 'checking' ? 'Checking' : 'Tune in'}
+            </button>
+
+            {message && (
+              <p
+                className="v3-caption border border-dashed border-ink px-3 py-2 text-ink"
+                role={phase === 'error' ? 'alert' : 'status'}
+              >
+                {message}
+              </p>
+            )}
+          </form>
+
+          {savedStations.length > 0 && (
+            <div className="mt-6 border-t border-dashed border-ink pt-4">
+              <div className="v3-caption mb-2 text-muted">Saved</div>
+              <div className="grid gap-2">
+                {savedStations.map(station => (
+                  <button
+                    key={station.slug}
+                    type="button"
+                    onClick={() => tuner?.setStation(station.slug)}
+                    className="v3-focus flex items-center justify-between gap-3 border border-line px-3 py-2 text-left hover:border-ink"
+                  >
+                    <span className="min-w-0 truncate text-[13px] font-bold">{station.name}</span>
+                    <span className="v3-caption shrink-0 text-muted">Open</span>
+                  </button>
+                ))}
+              </div>
+            </div>
+          )}
+        </section>
+      </div>
+    </main>
+  );
+}
