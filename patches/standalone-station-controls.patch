+function stationThemeClient(): StationClient {
+  if (!STANDALONE_SETUP || typeof window === 'undefined') return defaultStationClient;
+  try {
+    const slug = window.localStorage.getItem(STATION_STORAGE_KEY);
+    const stations: unknown = JSON.parse(window.localStorage.getItem(CUSTOM_STATIONS_KEY) || '[]');
+    if (!slug || !Array.isArray(stations)) return defaultStationClient;
+    const station = stations.find(item => {
+      if (!item || typeof item !== 'object') return false;
+      return (item as { slug?: unknown }).slug === slug;
+    }) as { url?: unknown } | undefined;
+    if (typeof station?.url === 'string' && station.url) {
+      return createStationClient(originForStation(station.url));
+    }
+  } catch {}
+  return defaultStationClient;
