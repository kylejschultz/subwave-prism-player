# Build source for the base SUB/WAVE web frontend.
# Default is the upstream commit the subwave-skins patch series was created for.
SUBWAVE_REPO=https://github.com/perminder-klair/subwave.git
SUBWAVE_REF=90db93086945eacd07d9a2b5fe607c41a5ec2fe6

# External skin source. The build applies patches from this repo, then copies
# skins/prism over the generated Prism skin files.
SUBWAVE_SKINS_REPO=https://github.com/kylejschultz/subwave-skins.git
SUBWAVE_SKINS_REF=main
APPLY_SUBWAVE_SKINS_PATCHES=1

# Set to 1 when the source ref contains Prism and you want the container's
# root player to default to Prism without relying on browser localStorage.
APPLY_PRISM_DEFAULT_PATCH=1

# Redirect / to /?skin=prism and redirect admin/setup routes back to the player.
APPLY_PLAYER_ONLY_PATCH=1
APPLY_STANDALONE_STATION_SETUP_PATCH=1
APPLY_PRISM_APP_BRANDING_PATCH=1

# Public URL for this player-only frontend.
PLAYER_SITE_URL=https://prism.gurthyy.xyz

# Optional default station endpoints. Leave blank for first-time setup.
SUBWAVE_PUBLIC_API_URL=
SUBWAVE_PUBLIC_STREAM_URL=
SUBWAVE_CONTROLLER_INTERNAL_URL=https://radio.gurthyy.xyz/api
NEXT_PUBLIC_SUBWAVE_STATION_SETUP=required

# Optional comma-separated theme IDs to show. Empty means show every station theme.
PRISM_THEME_IDS=

# Local host port for Unraid/compose before Cloudflare or another reverse proxy.
PLAYER_PORT=7703

# Optional analytics/build labels.
NEXT_PUBLIC_GA_ID=
SUBWAVE_BUILD_VERSION=prism-player
