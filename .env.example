# Build source for the Prism-enabled SUB/WAVE web frontend.
# This must point at a branch/tag/commit that contains the Prism skin.
SUBWAVE_REPO=https://github.com/perminder-klair/subwave.git
SUBWAVE_REF=develop

# Set to 1 when the source ref contains Prism and you want the container's
# root player to default to Prism without relying on browser localStorage.
APPLY_PRISM_DEFAULT_PATCH=1

# Public URL for this player-only frontend.
PLAYER_SITE_URL=https://player.example.com

# Existing SUB/WAVE station endpoints.
SUBWAVE_PUBLIC_API_URL=https://radio.kjho.me/api
SUBWAVE_PUBLIC_STREAM_URL=https://radio.kjho.me/stream.mp3
SUBWAVE_CONTROLLER_INTERNAL_URL=https://radio.kjho.me/api

# Local host port for Unraid/compose before Cloudflare or another reverse proxy.
PLAYER_PORT=7703

# Optional analytics/build labels.
NEXT_PUBLIC_GA_ID=
SUBWAVE_BUILD_VERSION=prism-player
